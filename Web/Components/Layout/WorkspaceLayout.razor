@layout MainLayout
@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject WorkspaceStore Store
@inject Auth0Client Auth
@inject WorkspaceTimerManager Timer
@inject WorkspaceBillingManager Billing
@inject WorkspaceCoachManager Coach
@inject WorkspaceAppearanceManager Appearance
@inject NavigationManager Navigation

<PageTitle>@Title &#8212; FlowMate</PageTitle>

<div class="app-frame">
    <WorkspaceSidebar View="@CurrentView" />
    <main class="main-area">
        <WorkspaceTopbar Title="@Title" />
        <section class="content-area">
            @if (!_ready)
            {
                <div class="workspace-loading" role="status" aria-live="polite">
                    <span class="loading-spinner" aria-hidden="true"></span>
                    Loading your workspace&#8230;
                </div>
            }
            else if (Auth.IsConfigured && !Auth.Session.SignedIn && !Auth.IsSessionExpired)
            {
                <WorkspaceSignIn />
            }
            else
            {
                @if (Auth.IsConfigured && Auth.IsSessionExpired)
                {
                    <div class="workspace-session-expired" role="alert">
                        <span>Your session expired. Your local work, current timer, and place in FlowMate are saved. Sign in again to continue syncing; you'll return to this page.</span>
                        <button class="workspace-sync-keep" @onclick='() => Auth.LoginAsync()'>Sign in again</button>
                    </div>
                }
                @if (Store.SyncState != WorkspaceSyncState.AuthenticationExpired)
                {
                    <div class="workspace-sync-notice" role="status" aria-live="polite">
                        <span>@Store.SyncMessage</span>
                        @if (Store.HasConflict)
                        {
                            <div class="workspace-sync-actions">
                                <button class="quiet-button" @onclick="Store.UseServerVersionAsync">Use server version</button>
                                <button class="workspace-sync-keep" @onclick="Store.KeepLocalVersionAsync">Keep my draft</button>
                            </div>
                        }
                        else if (Store.SyncState is WorkspaceSyncState.Offline or WorkspaceSyncState.Conflict or WorkspaceSyncState.Rejected or WorkspaceSyncState.Failed)
                        {
                            <button class="quiet-button" @onclick="Store.SaveAsync">Retry save</button>
                        }
                    </div>
                }
                @Body
            }
            <TaskEditorDialog />
            <ProjectEditorDialog />
        </section>
    </main>
</div>
