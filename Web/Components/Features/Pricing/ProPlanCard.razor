@inherits WorkspaceComponentBase
@inject WorkspaceBillingManager Billing

<article class="panel pricing-card pro-card">
    <div class="popular-tag">A LITTLE MORE ROOM</div>
    <span class="plan-label">FLOWMATE PRO</span>
    <h2>Make focus a practice.</h2>
    <div class="price">@Billing.PriceLabel</div>
    <p>More history, more insight, and space for every project.</p>
    <button class="plan-button primary" disabled="@(Billing.BillingState is null || Billing.CanManageSubscription || Billing.BillingState?.TrialUsed == true || Billing.CheckoutInProgress || !Billing.HasSelectedPrice)" @onclick="Billing.StartTrial">@(Billing.HasEntitledSubscription ? "Pro subscription active" : Billing.CanManageSubscription ? "Subscription already exists" : Billing.BillingState?.TrialUsed == true ? "Trial already used" : Billing.CheckoutInProgress ? "Opening checkout…" : Billing.HasSelectedPrice ? $"Try Pro for 14 days ({(Billing.Annual ? "annual" : "monthly")})" : "Pricing unavailable")</button>
    @if (!Billing.HasEntitledSubscription && !Billing.CanManageSubscription)
    {
        <small class="trial-copy">Payment method required at signup. No charge for 14 days; your selected plan is charged after the trial unless you cancel.</small>
    }
    @if (Billing.CurrentSubscriptionStatus == SubscriptionStatus.Trialing && Billing.BillingState?.PeriodEndsAt is { } trialEnd)
    {
        <p class="trial-copy">Your trial ends @trialEnd.ToLocalTime().ToString("d"). Cancel before then to avoid the @Billing.RenewalChargeLabel charge. After the trial, Free includes 3 projects and 10 coach prompts per month; your workspace data stays available.</p>
    }
    <button class="checkout-button" disabled="@((!Billing.HasSelectedPrice && !Billing.CanManageSubscription) || Billing.CheckoutInProgress || Billing.BillingState is null)" @onclick="Billing.BuyPro">@(Billing.CurrentSubscriptionStatus is SubscriptionStatus.PastDue or SubscriptionStatus.Unpaid ? "Resolve payment" : Billing.CanManageSubscription ? "Manage subscription" : Billing.CheckoutInProgress ? "Opening checkout…" : Billing.HasSelectedPrice ? $"Subscribe {(Billing.Annual ? "annually" : "monthly")}" : "Pricing unavailable")</button>
    <ul>
        <li>&#10003; Up to 25 projects</li>
        <li>&#10003; One year of report history</li>
        <li>&#10003; 100 coach prompts each month</li>
        <li>&#10003; Everything in Free</li>
    </ul>
</article>
