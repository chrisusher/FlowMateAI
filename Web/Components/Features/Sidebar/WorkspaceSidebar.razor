@inherits WorkspaceComponentBase
@inject WorkspaceStatistics Stats
@inject Auth0Client Auth

<aside class="sidebar">
    <a class="brand" href="">
        <img class="brand-mark" src="branding/flowmate-symbol.svg" alt="" />
        <span>flowmate<span class="brand-ai">.ai</span></span>
    </a>
    <div class="workspace-label">WORKSPACE</div>
    <nav class="side-nav">
        @foreach (var item in NavItems)
        {
            <a class="side-link @(View == item.Key ? "active" : "")" href="@(item.Key == "today" ? "" : item.Key)" aria-label="@item.Label" aria-current="@(View == item.Key ? "page" : null)">
                <span class="nav-icon" aria-hidden="true">@((MarkupString)item.Icon)</span>
                <span>@item.Label</span>
                @if (item.Key == "today" && Stats.PlannedTasks.Any())
                {
                    <span class="nav-count">@Stats.PlannedTasks.Count()</span>
                }
            </a>
        }
        <a class="side-link assistant-link" href="settings#integrations" aria-label="Connect your AI assistant">
            <span class="nav-icon" aria-hidden="true">&#8644;</span>
            <span class="assistant-full" aria-hidden="true">Connect your AI assistant</span>
            <span class="assistant-compact" aria-hidden="true">Assistant</span>
        </a>
    </nav>
    <div class="sidebar-bottom">
        <UpgradeCard />
        <div class="profile-area" @onkeydown="HandleProfileKeyDown">
        @if (_profileMenuOpen)
        {
            <div class="profile-menu" id="sidebar-profile-menu">
                <a href="settings">Account settings</a>
                @if (Auth.Session.SignedIn)
                {
                    <button type="button" @onclick="Auth.LogoutAsync">Sign out</button>
                }
            </div>
        }
        <a class="profile-link" href="settings" aria-label="Account settings for @Store.Data.DisplayName">
            <span class="avatar" aria-hidden="true">@ProfileInitials</span>
            <span class="profile-copy">
                <strong>@Store.Data.DisplayName</strong>
                <small>@Store.Data.Plan plan</small>
            </span>
        </a>
        <button type="button" class="profile-menu-toggle" aria-label="Account menu" aria-expanded="@_profileMenuOpen.ToString().ToLowerInvariant()" aria-controls="sidebar-profile-menu" @onclick="ToggleProfileMenu">&#8942;</button>
        </div>
    </div>
</aside>


@code {
    private string ProfileInitials
    {
        get
        {
            var parts = Store.Data.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            return parts.Length switch
            {
                0 => "FM",
                1 => char.ToUpperInvariant(parts[0][0]).ToString(),
                _ => $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
            };
        }
    }
}
