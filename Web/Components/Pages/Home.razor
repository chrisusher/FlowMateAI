    private async Task NewConversation() { Store.Data.Conversations.Insert(0, new() { Title = "A fresh perspective" }); ChatMessages = []; await Save(); }
    private async Task SelectConversation(ConversationRecord c) { if (Store.Data.Conversations.Remove(c)) Store.Data.Conversations.Insert(0, c); LoadChatMessages(); await Save(); }
    private async Task UsePrompt(string prompt)
    {
        if (_sending) return;
        await _chat!.SendMessage(prompt, "user");
    }
    private RadzenChat? _chat;
    private void LoadChatMessages() => ChatMessages = ActiveConversation.Messages.Select(message => new ChatMessage
    {
        Content = message.Text,
        UserId = message.Role == "user" ? "user" : "coach",
        Timestamp = message.CreatedAt.LocalDateTime
    }).ToList();
    private async Task SendMessage(ChatMessage message)
    {
        var text = message.Content.Trim();
        if (text.Length == 0) return;
        if (_sending) return;
        _sending = true;
        var conversation = ActiveConversation;
        ChatMessages.Add(message);
        await InvokeAsync(StateHasChanged);
        try
        {
            if (Auth.Session.SignedIn)
            {
                CoachResponse? saved = null;
                try { saved = await Store.AskCoachAsync(text, conversation.Id); }
                catch (HttpRequestException) { }
                if (saved is not null)
                {
                    BillingState = BillingState is null ? null : BillingState with { PromptsUsed = saved.PromptsUsed, PromptLimit = saved.PromptLimit };
                    if (ActiveConversation.Id == conversation.Id) LoadChatMessages();
                    return;
                }
            }

            conversation.Messages.Add(new() { Role = "user", Text = text });
            conversation.UpdatedAt = DateTimeOffset.UtcNow;
            conversation.Messages.Add(new() { Role = "assistant", Text = Auth.Session.SignedIn ? "I couldn't reach the focus coach just now. Please try again." : CoachReply(text) });
            await Save();
            if (ActiveConversation.Id == conversation.Id) LoadChatMessages();
        }
        finally { _sending = false; await InvokeAsync(StateHasChanged); }
    }
    private string CoachReply(string prompt) { var next = PlannedTasks.Where(t => !t.IsComplete).OrderByDescending(t => t.Priority).FirstOrDefault(); var projectText = Store.Data.Projects.Count == 0 ? "your next step" : string.Join(", ", Store.Data.Projects.Take(2).Select(p => p.Name)); if (prompt.Contains("week", StringComparison.OrdinalIgnoreCase)) return $"You've logged {PeriodMinutes} focused minutes this week across {PeriodSessions} sessions. Your work has been spread across {projectText}. What felt easiest to return to?"; return next is null ? $"Your plan is clear for now. You've already put {TodayMinutes} minutes into focused work today. Would a short reset help you choose what comes next?" : $"Looking at what you've planned, **{next.Title}** feels like a useful next step{(next.Priority == TaskPriority.High ? " because you marked it high priority" : "")} . You have {TodayMinutes} focused minutes behind you today. Could you give this one a single 25-minute session?"; }
    private async Task Save() { await Store.SaveAsync(); }
