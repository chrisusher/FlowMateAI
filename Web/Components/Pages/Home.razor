@page "/"
@page "/today"
@page "/{View}"
@layout WorkspaceLayout
@inherits WorkspaceComponentBase
@inject WorkspaceStatistics Stats

<PageTitle>Today &#8212; FlowMate</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">@Stats.Greeting, @Stats.FirstName</div>
        <h1>Make today count.</h1>
        <p class="subheading">A little focus goes a long way. Here's your plan for today.</p>
    </div>
    <button class="quiet-button" @onclick='() => Go("tasks")'>+ Add a task</button>
</div>
<div class="today-grid">
    <div class="left-column">
        <FocusTimerCard />
        <TodayPlanCard />
    </div>
    <div class="right-column">
        <FocusStatsCard />
        <CoachPromoCard />
        <TodayProjectsCard />
    </div>
</div>
