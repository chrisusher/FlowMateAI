@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<header class="header wrap">
    <a class="brand" href="#top" aria-label="FlowMate AI home">
        <span class="brand-mark">✳
        </span> flowmate
        <span>ai
        </span>
    </a>
    <nav aria-label="Main navigation">
        <a href="#how-it-works">How it works
        </a>
        <a href="#features">Features
        </a>
        <a href="@AppUrl">Log in
        </a>
        <a class="button button-small" href="@TrialUrl">Start your trial
            <span>↗
            </span>
        </a>
    </nav>
</header>
<main id="top">
    <section class="hero wrap">
        <div class="hero-copy">
            <p class="eyebrow">
                <span>
                </span> MADE FOR INDEPENDENT MINDS
            </p>
            <h1>Do your best work.
                <br />
                <em>We'll keep track.
                </em>
            </h1>
            <p class="intro">Find your focus, capture your time, and turn the work you’ve done into something you can
                actually use.
            </p>
            <div class="actions">
                <a class="button" href="@TrialUrl">Start your trial
                    <span>↗
                    </span>
                </a>
                <a class="text-link" href="#how-it-works">See how it works
                    <span>↓
                    </span>
                </a>
            </div>
            <p class="hero-note">14-day Pro trial · Payment method required
            </p>
        </div>
        <div class="visual" aria-label="Illustration of a focus session and a timesheet">
            <div class="visual-orbit orbit-one">
            </div>
            <div class="visual-orbit orbit-two">
            </div>
            <div class="floating-label">✳ &nbsp; SPACE TO DO YOUR BEST WORK
            </div>
            <div class="dashboard">
                <div class="dash-head">
                    <span>YOUR FOCUS SPACE
                    </span>
                    <span>•••
                    </span>
                </div>
                <p class="dash-greeting">Good morning, Alex
                    <span>✳
                    </span>
                </p>
                <p class="dash-sub">Let’s make today count.
                </p>
                <div class="timer-card">
                    <div>
                        <span class="tiny">CURRENT SESSION
                        </span>
                        <strong>Deep work
                        </strong>
                        <small>Brand strategy · Project Atlas
                        </small>
                    </div>
                    <div class="timer">24
                        <span>:
                        </span>38
                    </div>
                    <div class="timer-bottom">
                        <span>● &nbsp; Focusing
                        </span>
                        <span>Ⅱ
                        </span>
                    </div>
                </div>
                <div class="dash-footer">
                    <div>
                        <span>THIS WEEK
                        </span>
                        <strong>12h 45m
                        </strong>
                    </div>
                    <div class="bars">
                        <i>
                        </i>
                        <i>
                        </i>
                        <i>
                        </i>
                        <i>
                        </i>
                        <i>
                        </i>
                    </div>
                </div>
            </div>
            <div class="summary-card">
                <span class="summary-icon">✦
                </span>
                <div>
                    <strong>Your week, made clear.
                    </strong>
                    <small>Ready for your next update.
                    </small>
                </div>
                <span>↗
                </span>
            </div>
            <span class="spark spark-one">✳
            </span>
            <span class="spark spark-two">✦
            </span>
        </div>
    </section>
    <section class="ticker">
        <div class="wrap ticker-inner">
            <span>LESS BUSYWORK
            </span>
            <b>✳
            </b>
            <span>MORE MOMENTUM
            </span>
            <b>✳
            </b>
            <span>TIME WELL SPENT
            </span>
            <b>✳
            </b>
            <span>YOUR WORK, IN FOCUS
            </span>
        </div>
    </section>
    <section id="how-it-works" class="section wrap">
        <div class="section-heading">
            <div>
                <p class="eyebrow">A BETTER WAY TO WORK
                </p>
                <h2>Make room for
                    <br />
                    <em>what matters.
                    </em>
                </h2>
            </div>
            <p>From the first focused minute to the last client update, FlowMate helps your work flow a little more
                naturally.
            </p>
        </div>
        <div class="steps">
            <article>
                <span class="step-no">01 / FOCUS
                </span>
                <div class="step-icon">◷
                </div>
                <h3>Settle into the work
                </h3>
                <p>Choose a task, start a focus session and give your best ideas the attention they deserve.
                </p>
            </article>
            <article>
                <span class="step-no">02 / TRACK
                </span>
                <div class="step-icon">▥
                </div>
                <h3>See where time goes
                </h3>
                <p>Keep your projects and completed sessions together, with a clearer picture of the work behind your
                    week.
                </p>
            </article>
            <article>
                <span class="step-no">03 / SHARE
                </span>
                <div class="step-icon">✦
                </div>
                <h3>Let your assistant help
                </h3>
                <p>Connect your AI assistant to read recorded time and project totals, then draft a timesheet or client
                    update for your review.
                </p>
            </article>
        </div>
    </section>
    <section id="features" class="feature">
        <div class="wrap feature-grid">
            <div>
                <p class="eyebrow">YOUR TIME HAS A STORY
                </p>
                <h2>Good work adds up.
                    <br />
                    <em>Now you can see it.
                    </em>
                </h2>
                <p>FlowMate brings focus sessions, projects and reports into one calm space. Connect an AI assistant
                    when you’re ready to make more of the time you’ve recorded.
                </p>
                <a class="text-link light-link" href="@AppUrl">Explore FlowMate
                    <span>↗
                    </span>
                </a>
            </div>
            <div class="quote-card">
                <span class="quote-star">✳
                </span>
                <p>“Show me this week’s time by project and help me draft a client update.”
                </p>
                <div class="quote-line">
                </div>
                <small>YOUR WORK → YOUR ASSISTANT → YOUR REVIEW
                </small>
                <p class="fine-print">Your assistant reads recorded focus time and project totals. It can’t edit entries
                    or send updates for you.
                </p>
            </div>
        </div>
    </section>
    <section class="closing wrap">
        <p class="eyebrow">READY WHEN YOU ARE
        </p>
        <h2>More flow.
            <br />
            <em>Less figuring it out.
            </em>
        </h2>
        <p>Make space for the work you love.
        </p>
        <a class="button" href="@TrialUrl">Start your trial
            <span>↗
            </span>
        </a>
    </section>
</main>
<footer class="footer">
    <div class="wrap footer-inner">
        <a class="brand" href="#top">
            <span class="brand-mark">✳
            </span> flowmate
            <span>ai
            </span>
        </a>
        <p>Made for the way you work.
        </p>
        <a href="@AppUrl">Log in ↗
        </a>
        <small>© @DateTime.Now.Year FlowMate AI
        </small>
    </div>
</footer>
@code {
    private string AppUrl => Configuration["AppUrl"] ?? "/frontend/";
    private string TrialUrl => $"{AppUrl.TrimEnd('/')}/pricing";
}
